# Load these values in your process environment; bao-mcp does not auto-load .env.
BAO_ADDR=http://127.0.0.1:8200
BAO_NAMESPACE=agent
MCP_LISTEN=127.0.0.1:8000
MCP_BODY_TIMEOUT_SECONDS=30
CACHE_PATH=cache.db
CACHE_IDLE_TTL_SECONDS=3600
CACHE_MAX_AGE_SECONDS=60
CACHE_MAX_ENTRIES=1024
BAO_TIMEOUT_SECONDS=30
# BAO_CACERT=/absolute/path/to/bao-ca.pem
# BAO_SKIP_VERIFY=false # Set true only to bypass Bao TLS certificate and hostname checks.
# MCP_ALLOWED_HOSTS=bao-mcp.example.com
# MCP_ALLOWED_ORIGINS=https://client.example.com
LOG_LEVEL=info
# Configure the MCP client with its own OpenBao bearer token.
